[
  { "id": "q1", "text": "我会为各种事情担忧。", "type": "scale", "dimension": "N" },
  { "id": "q2", "text": "我总往最坏的方面想。", "type": "scale", "dimension": "N" },
  { "id": "q3", "text": "我害怕的东西很多。", "type": "scale", "dimension": "N" },
  { "id": "q4", "text": "我很容易感到压力大。", "type": "scale", "dimension": "N" },
  { "id": "q5", "text": "我容易发怒。", "type": "scale", "dimension": "N" },
  { "id": "q6", "text": "我容易被惹恼。", "type": "scale", "dimension": "N" },
  { "id": "q7", "text": "我会控制不住发脾气。", "type": "scale", "dimension": "N" },
  { "id": "q8", "text": "我不容易被烦到。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q9", "text": "我经常情绪低落。", "type": "scale", "dimension": "N" },
  { "id": "q10", "text": "我讨厌自己。", "type": "scale", "dimension": "N" },
  { "id": "q11", "text": "我常常闷闷不乐。", "type": "scale", "dimension": "N" },
  { "id": "q12", "text": "我对自己感觉挺好。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q13", "text": "我很难主动接近别人。", "type": "scale", "dimension": "N" },
  { "id": "q14", "text": "我害怕引起别人对我的注意。", "type": "scale", "dimension": "N" },
  { "id": "q15", "text": "我只有在朋友身边才感到自在。", "type": "scale", "dimension": "N" },
  { "id": "q16", "text": "尴尬的社交场合不会让我困扰。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q17", "text": "我会控制不住地暴饮暴食、放纵自己。", "type": "scale", "dimension": "N" },
  { "id": "q18", "text": "我很少放纵自己。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q19", "text": "我能轻松抵制诱惑。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q20", "text": "我能控制自己的欲望。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q21", "text": "我容易惊慌失措。", "type": "scale", "dimension": "N" },
  { "id": "q22", "text": "我容易被事情压垮。", "type": "scale", "dimension": "N" },
  { "id": "q23", "text": "我觉得自己应付不了事情。", "type": "scale", "dimension": "N" },
  { "id": "q24", "text": "我在压力下能保持冷静。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q25", "text": "我很容易交到朋友。", "type": "scale", "dimension": "E" },
  { "id": "q26", "text": "我和别人在一起时感到自在。", "type": "scale", "dimension": "E" },
  { "id": "q27", "text": "我回避与他人接触。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q28", "text": "我与人保持距离。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q29", "text": "我喜欢大型聚会。", "type": "scale", "dimension": "E" },
  { "id": "q30", "text": "我在聚会上和很多不同的人交谈。", "type": "scale", "dimension": "E" },
  { "id": "q31", "text": "我更愿意独处。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q32", "text": "我避开人群。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q33", "text": "我喜欢拍板做主。", "type": "scale", "dimension": "E" },
  { "id": "q34", "text": "我会试着带领别人。", "type": "scale", "dimension": "E" },
  { "id": "q35", "text": "我会掌控事情。", "type": "scale", "dimension": "E" },
  { "id": "q36", "text": "我等别人带头。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q37", "text": "我总是忙个不停。", "type": "scale", "dimension": "E" },
  { "id": "q38", "text": "我总是马不停蹄。", "type": "scale", "dimension": "E" },
  { "id": "q39", "text": "我业余时间会做很多事。", "type": "scale", "dimension": "E" },
  { "id": "q40", "text": "我喜欢轻松悠着来。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q41", "text": "我热爱刺激。", "type": "scale", "dimension": "E" },
  { "id": "q42", "text": "我爱冒险。", "type": "scale", "dimension": "E" },
  { "id": "q43", "text": "我享受无所顾忌的感觉。", "type": "scale", "dimension": "E" },
  { "id": "q44", "text": "我会表现得狂放不羁。", "type": "scale", "dimension": "E" },
  { "id": "q45", "text": "我浑身散发着快乐。", "type": "scale", "dimension": "E" },
  { "id": "q46", "text": "我总能玩得很开心。", "type": "scale", "dimension": "E" },
  { "id": "q47", "text": "我热爱生活。", "type": "scale", "dimension": "E" },
  { "id": "q48", "text": "我凡事都看光明的一面。", "type": "scale", "dimension": "E" },
  { "id": "q49", "text": "我有丰富的想象力。", "type": "scale", "dimension": "O" },
  { "id": "q50", "text": "我喜欢天马行空的幻想。", "type": "scale", "dimension": "O" },
  { "id": "q51", "text": "我爱做白日梦。", "type": "scale", "dimension": "O" },
  { "id": "q52", "text": "我喜欢陷入沉思。", "type": "scale", "dimension": "O" },
  { "id": "q53", "text": "我相信艺术很重要。", "type": "scale", "dimension": "O" },
  { "id": "q54", "text": "我能发现别人注意不到的美。", "type": "scale", "dimension": "O" },
  { "id": "q55", "text": "我不喜欢诗歌。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q56", "text": "我不喜欢去美术馆。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q57", "text": "我的情绪体验很强烈。", "type": "scale", "dimension": "O" },
  { "id": "q58", "text": "我能感受到别人的情绪。", "type": "scale", "dimension": "O" },
  { "id": "q59", "text": "我很少留意自己的情绪反应。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q60", "text": "我不理解那些容易动感情的人。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q61", "text": "比起一成不变，我更喜欢变化。", "type": "scale", "dimension": "O" },
  { "id": "q62", "text": "我宁愿守着自己熟悉的东西。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q63", "text": "我不喜欢变化。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q64", "text": "我固守传统做法。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q65", "text": "我爱读有挑战性的读物。", "type": "scale", "dimension": "O" },
  { "id": "q66", "text": "我避开哲学讨论。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q67", "text": "我很难理解抽象的概念。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q68", "text": "我对理论性讨论不感兴趣。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q69", "text": "我倾向把票投给持自由派立场的候选人。", "type": "scale", "dimension": "O" },
  { "id": "q70", "text": "我认为世上没有绝对的对错。", "type": "scale", "dimension": "O" },
  { "id": "q71", "text": "我倾向把票投给持保守立场的候选人。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q72", "text": "我认为对犯罪就应该严厉打击。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q73", "text": "我信任别人。", "type": "scale", "dimension": "A" },
  { "id": "q74", "text": "我相信别人是善意的。", "type": "scale", "dimension": "A" },
  { "id": "q75", "text": "我相信人们说的话。", "type": "scale", "dimension": "A" },
  { "id": "q76", "text": "我不信任别人。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q77", "text": "我会利用别人来达成自己的目的。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q78", "text": "我会靠作弊抢占先机。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q79", "text": "我会占别人便宜。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q80", "text": "我会阻挠别人的计划。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q81", "text": "我关心别人。", "type": "scale", "dimension": "A" },
  { "id": "q82", "text": "我乐于助人。", "type": "scale", "dimension": "A" },
  { "id": "q83", "text": "我对别人的感受漠不关心。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q84", "text": "我舍不得花时间在别人身上。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q85", "text": "我喜欢来一场痛快的争辩。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q86", "text": "我会对人大吼大叫。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q87", "text": "我会侮辱别人。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q88", "text": "我会报复别人。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q89", "text": "我认为我比别人强。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q90", "text": "我对自己评价很高。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q91", "text": "我自视甚高。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q92", "text": "我会夸耀自己的优点。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q93", "text": "我同情无家可归的人。", "type": "scale", "dimension": "A" },
  { "id": "q94", "text": "我同情那些境况不如我的人。", "type": "scale", "dimension": "A" },
  { "id": "q95", "text": "我对别人的问题不感兴趣。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q96", "text": "我尽量不去想那些穷困的人。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q97", "text": "我能顺利完成任务。", "type": "scale", "dimension": "C" },
  { "id": "q98", "text": "我做的事都很出色。", "type": "scale", "dimension": "C" },
  { "id": "q99", "text": "我处理任务得心应手。", "type": "scale", "dimension": "C" },
  { "id": "q100", "text": "我懂得怎么把事情办成。", "type": "scale", "dimension": "C" },
  { "id": "q101", "text": "我喜欢收拾整理。", "type": "scale", "dimension": "C" },
  { "id": "q102", "text": "我经常忘记把东西放回原处。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q103", "text": "我把房间弄得乱七八糟。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q104", "text": "我随手乱放自己的东西。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q105", "text": "我信守承诺。", "type": "scale", "dimension": "C" },
  { "id": "q106", "text": "我说真话。", "type": "scale", "dimension": "C" },
  { "id": "q107", "text": "我会违反规则。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q108", "text": "我会违背自己的承诺。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q109", "text": "我做的总比别人期待的多。", "type": "scale", "dimension": "C" },
  { "id": "q110", "text": "我努力工作。", "type": "scale", "dimension": "C" },
  { "id": "q111", "text": "我在工作上花的时间和精力很少。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q112", "text": "我干活只求过得去。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q113", "text": "我总是提前做好准备。", "type": "scale", "dimension": "C" },
  { "id": "q114", "text": "我会执行自己的计划。", "type": "scale", "dimension": "C" },
  { "id": "q115", "text": "我浪费自己的时间。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q116", "text": "我很难着手开始任务。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q117", "text": "我会不加思考就一头扎进事情里。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q118", "text": "我会仓促做决定。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q119", "text": "我做事急匆匆、贸然行事。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q120", "text": "我做事不过脑子。", "type": "scale", "dimension": "C", "reverse": true }
]
