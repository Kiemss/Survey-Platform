[
  { "id": "b1", "type": "scale", "text": "有时我会控制不住想要动手打人的冲动。", "dimension": "physical" },
  { "id": "b2", "type": "scale", "text": "只要受到足够的挑衅，我就可能动手打人。", "dimension": "physical" },
  { "id": "b3", "type": "scale", "text": "如果有人打我，我会还手。", "dimension": "physical" },
  { "id": "b4", "type": "scale", "text": "我与人发生肢体冲突的次数比一般人多一些。", "dimension": "physical" },
  { "id": "b5", "type": "scale", "text": "如果必须用武力来维护自己的权利，我会这么做。", "dimension": "physical" },
  { "id": "b6", "type": "scale", "text": "有些人被我逼急了，我们会动起手来。", "dimension": "physical" },
  { "id": "b7", "type": "scale", "text": "我认为没有任何理由去动手打人。", "dimension": "physical", "reverse": true },
  { "id": "b8", "type": "scale", "text": "我曾威胁过认识的人。", "dimension": "physical" },
  { "id": "b9", "type": "scale", "text": "我曾气得摔坏过东西。", "dimension": "physical" },
  { "id": "b10", "type": "scale", "text": "当我不同意朋友的看法时，我会直说。", "dimension": "verbal" },
  { "id": "b11", "type": "scale", "text": "我经常发现自己与别人意见不合。", "dimension": "verbal" },
  { "id": "b12", "type": "scale", "text": "有人惹恼我时，我可能会直接告诉他/她我对他的看法。", "dimension": "verbal" },
  { "id": "b13", "type": "scale", "text": "当别人与我意见相左时，我忍不住要争个明白。", "dimension": "verbal" },
  { "id": "b14", "type": "scale", "text": "我的朋友说我是个爱抬杠的人。", "dimension": "verbal" },
  { "id": "b15", "type": "scale", "text": "我火气来得快，但消得也快。", "dimension": "anger" },
  { "id": "b16", "type": "scale", "text": "受到挫折时，我会把烦躁表现出来。", "dimension": "anger" },
  { "id": "b17", "type": "scale", "text": "我有时觉得自己像个一点就炸的火药桶。", "dimension": "anger" },
  { "id": "b18", "type": "scale", "text": "我是个脾气温和、遇事冷静的人。", "dimension": "anger", "reverse": true },
  { "id": "b19", "type": "scale", "text": "有些朋友觉得我是个火爆脾气。", "dimension": "anger" },
  { "id": "b20", "type": "scale", "text": "有时我会无缘无故地大发脾气。", "dimension": "anger" },
  { "id": "b21", "type": "scale", "text": "我很难控制自己的脾气。", "dimension": "anger" },
  { "id": "b22", "type": "scale", "text": "有时嫉妒会把我折磨得很苦。", "dimension": "hostility" },
  { "id": "b23", "type": "scale", "text": "有时我觉得生活待我很不公平。", "dimension": "hostility" },
  { "id": "b24", "type": "scale", "text": "别人似乎总能碰上好运。", "dimension": "hostility" },
  { "id": "b25", "type": "scale", "text": "我有时不明白自己心里为什么会积攒这么多怨气。", "dimension": "hostility" },
  { "id": "b26", "type": "scale", "text": "我知道朋友们其实会在背后议论我。", "dimension": "hostility" },
  { "id": "b27", "type": "scale", "text": "我对过分热情的陌生人会持怀疑态度。", "dimension": "hostility" },
  { "id": "b28", "type": "scale", "text": "有时我觉得别人在背后嘲笑我。", "dimension": "hostility" },
  { "id": "b29", "type": "scale", "text": "当别人对我特别好的时候，我会怀疑他们想从我这里得到什么。", "dimension": "hostility" }
]
