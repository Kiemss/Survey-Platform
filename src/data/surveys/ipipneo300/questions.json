[
  { "id": "q1", "text": "我会为各种事情担忧。", "type": "scale", "dimension": "N" },
  { "id": "q2", "text": "我总往最坏的方面想。", "type": "scale", "dimension": "N" },
  { "id": "q3", "text": "我害怕的东西很多。", "type": "scale", "dimension": "N" },
  { "id": "q4", "text": "我很容易感到压力大。", "type": "scale", "dimension": "N" },
  { "id": "q5", "text": "我容易陷在自己的问题里出不来。", "type": "scale", "dimension": "N" },
  { "id": "q6", "text": "我不轻易被事情烦扰。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q7", "text": "我大部分时间都很放松。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q8", "text": "一般的事情很难扰乱我的心绪。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q9", "text": "我不为已经发生的事情担心。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q10", "text": "我能很快适应新环境。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q11", "text": "我容易发怒。", "type": "scale", "dimension": "N" },
  { "id": "q12", "text": "我容易被惹恼。", "type": "scale", "dimension": "N" },
  { "id": "q13", "text": "我容易心烦意乱。", "type": "scale", "dimension": "N" },
  { "id": "q14", "text": "我经常心情不好。", "type": "scale", "dimension": "N" },
  { "id": "q15", "text": "我会控制不住发脾气。", "type": "scale", "dimension": "N" },
  { "id": "q16", "text": "我很少被惹恼。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q17", "text": "我很少大发脾气。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q18", "text": "我不容易被烦到。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q19", "text": "我能保持冷静。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q20", "text": "我很少抱怨。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q21", "text": "我经常情绪低落。", "type": "scale", "dimension": "N" },
  { "id": "q22", "text": "我讨厌自己。", "type": "scale", "dimension": "N" },
  { "id": "q23", "text": "我常常闷闷不乐。", "type": "scale", "dimension": "N" },
  { "id": "q24", "text": "我对自己的评价很低。", "type": "scale", "dimension": "N" },
  { "id": "q25", "text": "我的情绪变化很大。", "type": "scale", "dimension": "N" },
  { "id": "q26", "text": "我会感到绝望。", "type": "scale", "dimension": "N" },
  { "id": "q27", "text": "我觉得自己的生活缺乏方向。", "type": "scale", "dimension": "N" },
  { "id": "q28", "text": "我很少情绪低落。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q29", "text": "我对自己感觉挺好。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q30", "text": "我对自己非常满意。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q31", "text": "我容易被人吓住。", "type": "scale", "dimension": "N" },
  { "id": "q32", "text": "我总怕自己做错事。", "type": "scale", "dimension": "N" },
  { "id": "q33", "text": "我很难主动接近别人。", "type": "scale", "dimension": "N" },
  { "id": "q34", "text": "我害怕引起别人对我的注意。", "type": "scale", "dimension": "N" },
  { "id": "q35", "text": "我只有在朋友身边才感到自在。", "type": "scale", "dimension": "N" },
  { "id": "q36", "text": "我说话常常磕磕绊绊。", "type": "scale", "dimension": "N" },
  { "id": "q37", "text": "我不容易感到难为情。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q38", "text": "我在陌生的场合也很自在。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q39", "text": "尴尬的社交场合不会让我困扰。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q40", "text": "我能挺身而出维护自己。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q41", "text": "我经常吃得太多。", "type": "scale", "dimension": "N" },
  { "id": "q42", "text": "我不明白自己为什么会做某些事。", "type": "scale", "dimension": "N" },
  { "id": "q43", "text": "我常做事之后又后悔。", "type": "scale", "dimension": "N" },
  { "id": "q44", "text": "我会控制不住地暴饮暴食、放纵自己。", "type": "scale", "dimension": "N" },
  { "id": "q45", "text": "我特别爱吃。", "type": "scale", "dimension": "N" },
  { "id": "q46", "text": "我很少放纵自己。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q47", "text": "我能轻松抵制诱惑。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q48", "text": "我能控制自己的欲望。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q49", "text": "我花钱从不超出自己的承受能力。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q50", "text": "我从不挥霍。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q51", "text": "我容易惊慌失措。", "type": "scale", "dimension": "N" },
  { "id": "q52", "text": "我容易被事情压垮。", "type": "scale", "dimension": "N" },
  { "id": "q53", "text": "我觉得自己应付不了事情。", "type": "scale", "dimension": "N" },
  { "id": "q54", "text": "我拿不定主意。", "type": "scale", "dimension": "N" },
  { "id": "q55", "text": "我会被情绪淹没。", "type": "scale", "dimension": "N" },
  { "id": "q56", "text": "我在压力下能保持冷静。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q57", "text": "我能应付复杂的问题。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q58", "text": "我知道怎么应对困难。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q59", "text": "我能很快从挫折中恢复过来。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q60", "text": "即使在紧张的局面中我也能保持镇定。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q61", "text": "我很容易交到朋友。", "type": "scale", "dimension": "E" },
  { "id": "q62", "text": "我能很快和别人热络起来。", "type": "scale", "dimension": "E" },
  { "id": "q63", "text": "我和别人在一起时感到自在。", "type": "scale", "dimension": "E" },
  { "id": "q64", "text": "我在他人面前举止自如。", "type": "scale", "dimension": "E" },
  { "id": "q65", "text": "我能让别人开心起来。", "type": "scale", "dimension": "E" },
  { "id": "q66", "text": "别人很难了解我。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q67", "text": "我和别人在一起时常常感到不自在。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q68", "text": "我回避与他人接触。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q69", "text": "我对别人提不起兴趣。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q70", "text": "我与人保持距离。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q71", "text": "我喜欢大型聚会。", "type": "scale", "dimension": "E" },
  { "id": "q72", "text": "我在聚会上和很多不同的人交谈。", "type": "scale", "dimension": "E" },
  { "id": "q73", "text": "我喜欢成为群体的一员。", "type": "scale", "dimension": "E" },
  { "id": "q74", "text": "我会拉别人一起参与我在做的事。", "type": "scale", "dimension": "E" },
  { "id": "q75", "text": "我喜欢惊喜派对。", "type": "scale", "dimension": "E" },
  { "id": "q76", "text": "我更愿意独处。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q77", "text": "我希望别人别来打扰我。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q78", "text": "我不喜欢人多拥挤的活动。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q79", "text": "我避开人群。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q80", "text": "我偏好安静。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q81", "text": "我喜欢拍板做主。", "type": "scale", "dimension": "E" },
  { "id": "q82", "text": "我会试着带领别人。", "type": "scale", "dimension": "E" },
  { "id": "q83", "text": "我能说服别人去做事。", "type": "scale", "dimension": "E" },
  { "id": "q84", "text": "我力求影响别人。", "type": "scale", "dimension": "E" },
  { "id": "q85", "text": "我会掌控事情。", "type": "scale", "dimension": "E" },
  { "id": "q86", "text": "我等别人带头。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q87", "text": "我习惯待在幕后。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q88", "text": "我没什么想说的。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q89", "text": "我不喜欢引人注意。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q90", "text": "我会把看法憋在心里不说。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q91", "text": "我总是忙个不停。", "type": "scale", "dimension": "E" },
  { "id": "q92", "text": "我总是马不停蹄。", "type": "scale", "dimension": "E" },
  { "id": "q93", "text": "我业余时间会做很多事。", "type": "scale", "dimension": "E" },
  { "id": "q94", "text": "我能同时应付很多事情。", "type": "scale", "dimension": "E" },
  { "id": "q95", "text": "我反应很快。", "type": "scale", "dimension": "E" },
  { "id": "q96", "text": "我喜欢轻松悠着来。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q97", "text": "我做事喜欢慢慢来。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q98", "text": "我喜欢悠闲的生活方式。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q99", "text": "我任由事情按自己的节奏发展。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q100", "text": "我反应慢。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q101", "text": "我热爱刺激。", "type": "scale", "dimension": "E" },
  { "id": "q102", "text": "我爱冒险。", "type": "scale", "dimension": "E" },
  { "id": "q103", "text": "我喜欢动感十足的活动。", "type": "scale", "dimension": "E" },
  { "id": "q104", "text": "我喜欢置身于喧闹的人群中。", "type": "scale", "dimension": "E" },
  { "id": "q105", "text": "我享受无所顾忌的感觉。", "type": "scale", "dimension": "E" },
  { "id": "q106", "text": "我会表现得狂放不羁。", "type": "scale", "dimension": "E" },
  { "id": "q107", "text": "什么事我都愿意试一次。", "type": "scale", "dimension": "E" },
  { "id": "q108", "text": "我追求危险刺激。", "type": "scale", "dimension": "E" },
  { "id": "q109", "text": "我绝不会去玩滑翔或蹦极。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q110", "text": "我不喜欢吵闹的音乐。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q111", "text": "我浑身散发着快乐。", "type": "scale", "dimension": "E" },
  { "id": "q112", "text": "我总能玩得很开心。", "type": "scale", "dimension": "E" },
  { "id": "q113", "text": "我会流露出孩子般的快乐。", "type": "scale", "dimension": "E" },
  { "id": "q114", "text": "我笑对人生。", "type": "scale", "dimension": "E" },
  { "id": "q115", "text": "我热爱生活。", "type": "scale", "dimension": "E" },
  { "id": "q116", "text": "我凡事都看光明的一面。", "type": "scale", "dimension": "E" },
  { "id": "q117", "text": "我会放声大笑。", "type": "scale", "dimension": "E" },
  { "id": "q118", "text": "我能逗乐朋友们。", "type": "scale", "dimension": "E" },
  { "id": "q119", "text": "我不容易被逗乐。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q120", "text": "我很少开玩笑。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q121", "text": "我有丰富的想象力。", "type": "scale", "dimension": "O" },
  { "id": "q122", "text": "我喜欢天马行空的幻想。", "type": "scale", "dimension": "O" },
  { "id": "q123", "text": "我爱做白日梦。", "type": "scale", "dimension": "O" },
  { "id": "q124", "text": "我喜欢陷入沉思。", "type": "scale", "dimension": "O" },
  { "id": "q125", "text": "我沉醉于自己的幻想。", "type": "scale", "dimension": "O" },
  { "id": "q126", "text": "我会花时间反思事情。", "type": "scale", "dimension": "O" },
  { "id": "q127", "text": "我很少做白日梦。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q128", "text": "我想象力并不丰富。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q129", "text": "我很少陷入沉思。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q130", "text": "我很难在脑中想象出画面。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q131", "text": "我相信艺术很重要。", "type": "scale", "dimension": "O" },
  { "id": "q132", "text": "我喜欢音乐。", "type": "scale", "dimension": "O" },
  { "id": "q133", "text": "我能发现别人注意不到的美。", "type": "scale", "dimension": "O" },
  { "id": "q134", "text": "我喜爱花。", "type": "scale", "dimension": "O" },
  { "id": "q135", "text": "我欣赏自然之美。", "type": "scale", "dimension": "O" },
  { "id": "q136", "text": "我不喜欢艺术。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q137", "text": "我不喜欢诗歌。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q138", "text": "我不喜欢去美术馆。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q139", "text": "我不喜欢音乐会。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q140", "text": "我不喜欢看舞蹈演出。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q141", "text": "我的情绪体验很强烈。", "type": "scale", "dimension": "O" },
  { "id": "q142", "text": "我能感受到别人的情绪。", "type": "scale", "dimension": "O" },
  { "id": "q143", "text": "我会为自己认同的事业投入热情。", "type": "scale", "dimension": "O" },
  { "id": "q144", "text": "我乐于审视自己和生活。", "type": "scale", "dimension": "O" },
  { "id": "q145", "text": "我努力了解自己。", "type": "scale", "dimension": "O" },
  { "id": "q146", "text": "我很少情绪激动。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q147", "text": "我不太受情绪影响。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q148", "text": "我很少留意自己的情绪反应。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q149", "text": "我的情绪很少有起落。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q150", "text": "我不理解那些容易动感情的人。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q151", "text": "比起一成不变，我更喜欢变化。", "type": "scale", "dimension": "O" },
  { "id": "q152", "text": "我喜欢去没去过的地方。", "type": "scale", "dimension": "O" },
  { "id": "q153", "text": "我对很多事情都感兴趣。", "type": "scale", "dimension": "O" },
  { "id": "q154", "text": "我喜欢开启新的事情。", "type": "scale", "dimension": "O" },
  { "id": "q155", "text": "我宁愿守着自己熟悉的东西。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q156", "text": "我不喜欢变化。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q157", "text": "我打心底里不喜欢改变。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q158", "text": "我是个按习惯行事的人。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q159", "text": "我不喜欢没吃过的食物。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q160", "text": "我固守传统做法。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q161", "text": "我喜欢解决复杂的问题。", "type": "scale", "dimension": "O" },
  { "id": "q162", "text": "我爱读有挑战性的读物。", "type": "scale", "dimension": "O" },
  { "id": "q163", "text": "我词汇量丰富。", "type": "scale", "dimension": "O" },
  { "id": "q164", "text": "我能消化大量信息。", "type": "scale", "dimension": "O" },
  { "id": "q165", "text": "我喜欢琢磨事情。", "type": "scale", "dimension": "O" },
  { "id": "q166", "text": "我对抽象的观念不感兴趣。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q167", "text": "我避开哲学讨论。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q168", "text": "我很难理解抽象的概念。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q169", "text": "我对理论性讨论不感兴趣。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q170", "text": "我回避难读的读物。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q171", "text": "我倾向把票投给持自由派立场的候选人。", "type": "scale", "dimension": "O" },
  { "id": "q172", "text": "我认为世上没有绝对的对错。", "type": "scale", "dimension": "O" },
  { "id": "q173", "text": "我认为罪犯更应该得到帮助而不是惩罚。", "type": "scale", "dimension": "O" },
  { "id": "q174", "text": "我相信只有一个真正的宗教。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q175", "text": "我倾向把票投给持保守立场的候选人。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q176", "text": "我认为太多的税收被用于资助艺术家。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q177", "text": "我认为法律应该严格执行。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q178", "text": "我认为我们对罪犯太纵容了。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q179", "text": "我认为对犯罪就应该严厉打击。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q180", "text": "奏国歌时我喜欢起立致敬。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q181", "text": "我信任别人。", "type": "scale", "dimension": "A" },
  { "id": "q182", "text": "我相信别人是善意的。", "type": "scale", "dimension": "A" },
  { "id": "q183", "text": "我相信人们说的话。", "type": "scale", "dimension": "A" },
  { "id": "q184", "text": "我相信人基本上是有道德的。", "type": "scale", "dimension": "A" },
  { "id": "q185", "text": "我相信人性本善。", "type": "scale", "dimension": "A" },
  { "id": "q186", "text": "我觉得一切都会好起来的。", "type": "scale", "dimension": "A" },
  { "id": "q187", "text": "我不信任别人。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q188", "text": "我怀疑别人别有用心。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q189", "text": "我对他人心存戒备。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q190", "text": "我认为人本质上是邪恶的。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q191", "text": "我绝不会在报税上作假。", "type": "scale", "dimension": "A" },
  { "id": "q192", "text": "我坚守规则。", "type": "scale", "dimension": "A" },
  { "id": "q193", "text": "我会靠阿谀奉承往上爬。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q194", "text": "我会利用别人来达成自己的目的。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q195", "text": "我懂得怎么钻规则的空子。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q196", "text": "我会靠作弊抢占先机。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q197", "text": "我会对人施压。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q198", "text": "我会假装关心别人。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q199", "text": "我会占别人便宜。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q200", "text": "我会阻挠别人的计划。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q201", "text": "我会让别人感到受欢迎。", "type": "scale", "dimension": "A" },
  { "id": "q202", "text": "我能预判别人的需要。", "type": "scale", "dimension": "A" },
  { "id": "q203", "text": "我乐于助人。", "type": "scale", "dimension": "A" },
  { "id": "q204", "text": "我关心别人。", "type": "scale", "dimension": "A" },
  { "id": "q205", "text": "我总能说别人的好话。", "type": "scale", "dimension": "A" },
  { "id": "q206", "text": "我看不起别人。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q207", "text": "我对别人的感受漠不关心。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q208", "text": "我会让人感到不自在。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q209", "text": "我会对别人的困境袖手旁观。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q210", "text": "我舍不得花时间在别人身上。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q211", "text": "我很容易满足。", "type": "scale", "dimension": "A" },
  { "id": "q212", "text": "我受不了正面冲突。", "type": "scale", "dimension": "A" },
  { "id": "q213", "text": "我讨厌显得咄咄逼人。", "type": "scale", "dimension": "A" },
  { "id": "q214", "text": "我说话刻薄。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q215", "text": "我爱跟别人唱反调。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q216", "text": "我喜欢来一场痛快的争辩。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q217", "text": "我会对人大吼大叫。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q218", "text": "我会侮辱别人。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q219", "text": "我会报复别人。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q220", "text": "我会记仇。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q221", "text": "我不喜欢成为众人瞩目的焦点。", "type": "scale", "dimension": "A" },
  { "id": "q222", "text": "我不喜欢谈论自己。", "type": "scale", "dimension": "A" },
  { "id": "q223", "text": "我认为自己只是个普通人。", "type": "scale", "dimension": "A" },
  { "id": "q224", "text": "我很少自吹自擂。", "type": "scale", "dimension": "A" },
  { "id": "q225", "text": "我认为我比别人强。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q226", "text": "我对自己评价很高。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q227", "text": "我自视甚高。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q228", "text": "很多问题我都知道答案。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q229", "text": "我会夸耀自己的优点。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q230", "text": "我会让自己成为关注的焦点。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q231", "text": "我同情无家可归的人。", "type": "scale", "dimension": "A" },
  { "id": "q232", "text": "我同情那些境况不如我的人。", "type": "scale", "dimension": "A" },
  { "id": "q233", "text": "比起竞争，我更看重合作。", "type": "scale", "dimension": "A" },
  { "id": "q234", "text": "别人的痛苦会让我难过。", "type": "scale", "dimension": "A" },
  { "id": "q235", "text": "我对别人的问题不感兴趣。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q236", "text": "我不太喜欢心太软的人。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q237", "text": "我信奉以牙还牙。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q238", "text": "我尽量不去想那些穷困的人。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q239", "text": "我认为每个人都该自己顾好自己。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q240", "text": "我受不了软弱的人。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q241", "text": "我能顺利完成任务。", "type": "scale", "dimension": "C" },
  { "id": "q242", "text": "我做的事都很出色。", "type": "scale", "dimension": "C" },
  { "id": "q243", "text": "我处理任务得心应手。", "type": "scale", "dimension": "C" },
  { "id": "q244", "text": "我对自己的立场很有把握。", "type": "scale", "dimension": "C" },
  { "id": "q245", "text": "我能想出好办法。", "type": "scale", "dimension": "C" },
  { "id": "q246", "text": "我懂得怎么把事情办成。", "type": "scale", "dimension": "C" },
  { "id": "q247", "text": "我会误判形势。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q248", "text": "我搞不懂很多事情。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q249", "text": "我提供不了什么贡献。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q250", "text": "我看不出事情会有什么后果。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q251", "text": "我喜欢井然有序。", "type": "scale", "dimension": "C" },
  { "id": "q252", "text": "我喜欢收拾整理。", "type": "scale", "dimension": "C" },
  { "id": "q253", "text": "我希望一切都恰到好处。", "type": "scale", "dimension": "C" },
  { "id": "q254", "text": "我热爱秩序与规律。", "type": "scale", "dimension": "C" },
  { "id": "q255", "text": "我做事按计划来。", "type": "scale", "dimension": "C" },
  { "id": "q256", "text": "我经常忘记把东西放回原处。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q257", "text": "我把房间弄得乱七八糟。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q258", "text": "我随手乱放自己的东西。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q259", "text": "别人邋遢我也不在意。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q260", "text": "我不觉得杂乱会烦到我。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q261", "text": "我努力遵守规则。", "type": "scale", "dimension": "C" },
  { "id": "q262", "text": "我信守承诺。", "type": "scale", "dimension": "C" },
  { "id": "q263", "text": "我按时支付账单。", "type": "scale", "dimension": "C" },
  { "id": "q264", "text": "我说真话。", "type": "scale", "dimension": "C" },
  { "id": "q265", "text": "我听从良心的声音。", "type": "scale", "dimension": "C" },
  { "id": "q266", "text": "我会违反规则。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q267", "text": "我会违背自己的承诺。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q268", "text": "我会让别人替我履行职责。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q269", "text": "别人让我做什么我偏反着来。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q270", "text": "我会歪曲事实。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q271", "text": "我直奔目标。", "type": "scale", "dimension": "C" },
  { "id": "q272", "text": "我努力工作。", "type": "scale", "dimension": "C" },
  { "id": "q273", "text": "我把计划付诸行动。", "type": "scale", "dimension": "C" },
  { "id": "q274", "text": "我全身心投入任务。", "type": "scale", "dimension": "C" },
  { "id": "q275", "text": "我做的总比别人期待的多。", "type": "scale", "dimension": "C" },
  { "id": "q276", "text": "我对自己和别人都要求很高。", "type": "scale", "dimension": "C" },
  { "id": "q277", "text": "我追求高品质。", "type": "scale", "dimension": "C" },
  { "id": "q278", "text": "我没有很强的成功欲望。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q279", "text": "我干活只求过得去。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q280", "text": "我在工作上花的时间和精力很少。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q281", "text": "我马上就把杂活干完。", "type": "scale", "dimension": "C" },
  { "id": "q282", "text": "我总是提前做好准备。", "type": "scale", "dimension": "C" },
  { "id": "q283", "text": "我立刻着手开始任务。", "type": "scale", "dimension": "C" },
  { "id": "q284", "text": "我马上投入工作。", "type": "scale", "dimension": "C" },
  { "id": "q285", "text": "我会执行自己的计划。", "type": "scale", "dimension": "C" },
  { "id": "q286", "text": "我很难静下心来开始干活。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q287", "text": "我浪费自己的时间。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q288", "text": "我需要别人推一把才能开始。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q289", "text": "我很难着手开始任务。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q290", "text": "我会拖延决定。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q291", "text": "我尽量避免犯错。", "type": "scale", "dimension": "C" },
  { "id": "q292", "text": "我措辞谨慎。", "type": "scale", "dimension": "C" },
  { "id": "q293", "text": "我坚持自己选定的道路。", "type": "scale", "dimension": "C" },
  { "id": "q294", "text": "我会不加思考就一头扎进事情里。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q295", "text": "我会仓促做决定。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q296", "text": "我喜欢心血来潮就行动。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q297", "text": "我做事急匆匆、贸然行事。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q298", "text": "我会做疯狂的事。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q299", "text": "我做事不过脑子。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q300", "text": "我常常临时抱佛脚做计划。", "type": "scale", "dimension": "C", "reverse": true }
]
