[
  { "id": "e1", "type": "scale", "scalePoints": 5, "text": "我知道什么时候适合向别人倾诉自己的个人问题。" },
  { "id": "e2", "type": "scale", "scalePoints": 5, "text": "遇到困难时，我很难记起自己的目标，容易半途而废。", "reverse": true },
  { "id": "e3", "type": "scale", "scalePoints": 5, "text": "心情好的时候，我解决问题会更容易。" },
  { "id": "e4", "type": "scale", "scalePoints": 5, "text": "通过观察别人的面部表情，我能识别他们的情绪。" },
  { "id": "e5", "type": "scale", "scalePoints": 5, "text": "我知道自己情绪变化的原因。" },
  { "id": "e6", "type": "scale", "scalePoints": 5, "text": "心情好的时候，我容易冒出新想法。" },
  { "id": "e7", "type": "scale", "scalePoints": 5, "text": "我很难控制自己的情绪。", "reverse": true },
  { "id": "e8", "type": "scale", "scalePoints": 5, "text": "我能随时觉察到自己正在经历什么情绪。" },
  { "id": "e9", "type": "scale", "scalePoints": 5, "text": "我会通过设想好的结果来激励自己做事。" },
  { "id": "e10", "type": "scale", "scalePoints": 5, "text": "别人做得好时，我很难真心称赞他们。", "reverse": true },
  { "id": "e11", "type": "scale", "scalePoints": 5, "text": "我能察觉自己与人交流时传递出的非言语信息。" },
  { "id": "e12", "type": "scale", "scalePoints": 5, "text": "当别人讲述他们生活中的事时，我能感受到他们的情绪。" },
  { "id": "e13", "type": "scale", "scalePoints": 5, "text": "我能察觉别人肢体动作、语调里传递的信息。" },
  { "id": "e14", "type": "scale", "scalePoints": 5, "text": "心情不好时，我能比较快地让自己走出来。" },
  { "id": "e15", "type": "scale", "scalePoints": 5, "text": "我能通过语调听出对方话里的感受。" },
  { "id": "e16", "type": "scale", "scalePoints": 5, "text": "我很难体会别人的悲伤与快乐。", "reverse": true },
  { "id": "e17", "type": "scale", "scalePoints": 5, "text": "我能清楚地知道自己为什么高兴、为什么难过。" },
  { "id": "e18", "type": "scale", "scalePoints": 5, "text": "我会通过表情来推断别人的真实感受。" },
  { "id": "e19", "type": "scale", "scalePoints": 5, "text": "压力一大，我就容易乱了阵脚。", "reverse": true },
  { "id": "e20", "type": "scale", "scalePoints": 5, "text": "我能从挫折中较快恢复，继续朝目标努力。" },
  { "id": "e21", "type": "scale", "scalePoints": 5, "text": "我常常说不清自己此刻是什么情绪。", "reverse": true },
  { "id": "e22", "type": "scale", "scalePoints": 5, "text": "我懂得借助情绪信息来帮助自己做决定。" },
  { "id": "e23", "type": "scale", "scalePoints": 5, "text": "我会利用心情好的时候去完成有挑战性的任务。" },
  { "id": "e24", "type": "scale", "scalePoints": 5, "text": "我鼓励自己用积极的心态面对困难。" },
  { "id": "e25", "type": "scale", "scalePoints": 5, "text": "我很难觉察到别人的情绪变化。", "reverse": true },
  { "id": "e26", "type": "scale", "scalePoints": 5, "text": "我说话做事常常不顾场合和别人的感受。", "reverse": true },
  { "id": "e27", "type": "scale", "scalePoints": 5, "text": "我擅长察觉别人身上的情绪信号。" },
  { "id": "e28", "type": "scale", "scalePoints": 5, "text": "我经常被自己的情绪牵着走。", "reverse": true },
  { "id": "e29", "type": "scale", "scalePoints": 5, "text": "强烈的情绪上来时，我找不到有效的办法让自己平静。", "reverse": true },
  { "id": "e30", "type": "scale", "scalePoints": 5, "text": "我善于让别人感到自在和被理解。" },
  { "id": "e31", "type": "scale", "scalePoints": 5, "text": "别人聊起情绪类的话题时，我常常不知道该怎么回应。", "reverse": true },
  { "id": "e32", "type": "scale", "scalePoints": 5, "text": "我能通过想象美好的结果，帮助自己走出坏心情。" },
  { "id": "e33", "type": "scale", "scalePoints": 5, "text": "总的来说，我很了解自己的情绪状态。" }
]
