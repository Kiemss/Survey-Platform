[
  { "id": "m1", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我常常反复做没必要的事情，比如反复检查作业、反复洗手" },
  { "id": "m2", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我觉得有人总跟我过不去、故意为难我" },
  { "id": "m3", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我常常因为一点小事就发脾气" },
  { "id": "m4", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我很在意别人怎么看我，担心别人对我有不好的评价" },
  { "id": "m5", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我感到苦闷，高兴不起来" },
  { "id": "m6", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我常常感到心慌" },
  { "id": "m7", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我感到学习负担太重，压力很大" },
  { "id": "m8", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "换了新环境（比如新学校、新班级），我很长时间都适应不了" },
  { "id": "m9", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我的情绪忽好忽坏，波动很大" },
  { "id": "m10", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我觉得老师偏心，更喜欢别的同学" },
  { "id": "m11", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "上课时，我总忍不住想一些与学习无关的事情" },
  { "id": "m12", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我觉得别人在背后议论我、说我的坏话" },
  { "id": "m13", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我容易烦恼和激动" },
  { "id": "m14", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "在人多的场合，我感到不自在" },
  { "id": "m15", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我觉得前途暗淡，没有什么希望" },
  { "id": "m16", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我无缘无故地感到紧张、坐立不安" },
  { "id": "m17", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我害怕考试，考前总是特别紧张" },
  { "id": "m18", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我很难适应新的学习方法和节奏" },
  { "id": "m19", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我的情绪时好时坏，连自己也说不清原因" },
  { "id": "m20", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "看到别人比自己强，我心里就不舒服" },
  { "id": "m21", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "脑子里常冒出一些不必要的念头，明知不该想却控制不住" },
  { "id": "m22", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我觉得父母或老师对我不公平" },
  { "id": "m23", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我有过想摔东西或破坏东西的冲动" },
  { "id": "m24", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我觉得别人不理解我、不同情我" },
  { "id": "m25", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我感到孤独" },
  { "id": "m26", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我夜里睡不好，容易惊醒" },
  { "id": "m27", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我觉得功课越来越难，学起来很吃力" },
  { "id": "m28", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我在班集体中感到格格不入" },
  { "id": "m29", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "一点小事就能让我的心情大起大落" },
  { "id": "m30", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我常常嫉妒成绩好或条件比我好的同学" },
  { "id": "m31", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我做事总要反复核对、确认才放心" },
  { "id": "m32", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我觉得自己的付出常常得不到别人的理解" },
  { "id": "m33", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我经常与人争论、抬杠" },
  { "id": "m34", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "与人交往时，我容易紧张、脸红" },
  { "id": "m35", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我对什么事情都提不起兴趣" },
  { "id": "m36", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我一紧张就容易出汗、手抖" },
  { "id": "m37", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我讨厌上学，不想去学校" },
  { "id": "m38", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "遇到新情况、新变化，我常常手足无措" },
  { "id": "m39", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我容易冲动，事后又常常后悔" },
  { "id": "m40", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我觉得这个世界对我不公平" },
  { "id": "m41", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我总担心自己的衣着是否整齐、举止是否得体" },
  { "id": "m42", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我常常觉得别人想占我的便宜" },
  { "id": "m43", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我有时想骂人，甚至想动手" },
  { "id": "m44", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我总觉得别人对我的态度不太友好" },
  { "id": "m45", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我经常责怪自己，觉得自己没有价值" },
  { "id": "m46", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我常常为还没有发生的事情担心" },
  { "id": "m47", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我担心成绩下滑，怕辜负父母的期望" },
  { "id": "m48", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我对集体生活感到不习惯、很别扭" },
  { "id": "m49", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我的心情常常由兴奋一下子跌入低落" },
  { "id": "m50", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "看到别人受到表扬，我心里不服气" },
  { "id": "m51", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我常反复回忆做过的事情，明知没有必要却停不下来" },
  { "id": "m52", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我觉得大多数人是不可以信任的" },
  { "id": "m53", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "别人稍微冒犯我，我就难以忍受" },
  { "id": "m54", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我害怕在众人面前发言或表演" },
  { "id": "m55", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我觉得活着没有意思" },
  { "id": "m56", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我感到莫名的烦躁，怎么也静不下来" },
  { "id": "m57", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "一学习我就感到疲惫，提不起精神" },
  { "id": "m58", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我很难与新同学、新老师相处" },
  { "id": "m59", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "有人说我喜怒无常" },
  { "id": "m60", "type": "scale", "scalePoints": 5, "scaleLabels": ["无", "轻度", "中度", "偏重", "严重"], "text": "我常常觉得委屈，觉得没有人理解自己" }
]
