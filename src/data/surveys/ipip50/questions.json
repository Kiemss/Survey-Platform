[
  { "id": "q1", "text": "我是聚会中的灵魂人物。", "type": "scale", "dimension": "E" },
  { "id": "q2", "text": "我不太关心别人。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q3", "text": "我总是提前做好准备。", "type": "scale", "dimension": "C" },
  { "id": "q4", "text": "我很容易感到压力大。", "type": "scale", "dimension": "N" },
  { "id": "q5", "text": "我词汇量丰富。", "type": "scale", "dimension": "O" },
  { "id": "q6", "text": "我话不多。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q7", "text": "我对他人感兴趣。", "type": "scale", "dimension": "A" },
  { "id": "q8", "text": "我随手乱放自己的东西。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q9", "text": "我大部分时间都很放松。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q10", "text": "我很难理解抽象的概念。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q11", "text": "我在人群中感到自在。", "type": "scale", "dimension": "E" },
  { "id": "q12", "text": "我会侮辱别人。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q13", "text": "我注重细节。", "type": "scale", "dimension": "C" },
  { "id": "q14", "text": "我经常担忧各种事情。", "type": "scale", "dimension": "N" },
  { "id": "q15", "text": "我有丰富的想象力。", "type": "scale", "dimension": "O" },
  { "id": "q16", "text": "我习惯待在幕后、不引人注目。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q17", "text": "我能体会他人的感受。", "type": "scale", "dimension": "A" },
  { "id": "q18", "text": "我把事情搞得一团糟。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q19", "text": "我很少感到忧郁。", "type": "scale", "dimension": "N", "reverse": true },
  { "id": "q20", "text": "我对抽象的观念不感兴趣。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q21", "text": "我常常主动开启话题。", "type": "scale", "dimension": "E" },
  { "id": "q22", "text": "我不关心别人的问题。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q23", "text": "我马上就能把手头的活干完。", "type": "scale", "dimension": "C" },
  { "id": "q24", "text": "我容易被干扰而心烦意乱。", "type": "scale", "dimension": "N" },
  { "id": "q25", "text": "我有许多绝妙的点子。", "type": "scale", "dimension": "O" },
  { "id": "q26", "text": "我少言寡语。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q27", "text": "我心肠软。", "type": "scale", "dimension": "A" },
  { "id": "q28", "text": "我经常忘记把东西放回原处。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q29", "text": "我容易心烦气躁。", "type": "scale", "dimension": "N" },
  { "id": "q30", "text": "我缺乏想象力。", "type": "scale", "dimension": "O", "reverse": true },
  { "id": "q31", "text": "我在聚会上和很多不同的人交谈。", "type": "scale", "dimension": "E" },
  { "id": "q32", "text": "我对他人真的提不起兴趣。", "type": "scale", "dimension": "A", "reverse": true },
  { "id": "q33", "text": "我喜欢井然有序。", "type": "scale", "dimension": "C" },
  { "id": "q34", "text": "我的情绪变化很大。", "type": "scale", "dimension": "N" },
  { "id": "q35", "text": "我理解事物很快。", "type": "scale", "dimension": "O" },
  { "id": "q36", "text": "我不喜欢成为众人瞩目的焦点。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q37", "text": "我会专门抽出时间帮助别人。", "type": "scale", "dimension": "A" },
  { "id": "q38", "text": "我会逃避自己的职责。", "type": "scale", "dimension": "C", "reverse": true },
  { "id": "q39", "text": "我的情绪起伏很频繁。", "type": "scale", "dimension": "N" },
  { "id": "q40", "text": "我会使用比较高深的词汇。", "type": "scale", "dimension": "O" },
  { "id": "q41", "text": "我不介意成为大家关注的中心。", "type": "scale", "dimension": "E" },
  { "id": "q42", "text": "我能感受到别人的情绪。", "type": "scale", "dimension": "A" },
  { "id": "q43", "text": "我按日程安排行事。", "type": "scale", "dimension": "C" },
  { "id": "q44", "text": "我很容易被惹恼。", "type": "scale", "dimension": "N" },
  { "id": "q45", "text": "我会花时间静心思考。", "type": "scale", "dimension": "O" },
  { "id": "q46", "text": "我在陌生人面前很安静。", "type": "scale", "dimension": "E", "reverse": true },
  { "id": "q47", "text": "我能让别人感到放松自在。", "type": "scale", "dimension": "A" },
  { "id": "q48", "text": "我对自己的工作要求严苛。", "type": "scale", "dimension": "C" },
  { "id": "q49", "text": "我经常情绪低落。", "type": "scale", "dimension": "N" },
  { "id": "q50", "text": "我满脑子都是新点子。", "type": "scale", "dimension": "O" }
]
