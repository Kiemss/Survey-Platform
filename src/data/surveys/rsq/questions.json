[
  { "id": "r1", "type": "scale", "scalePoints": 5, "text": "我觉得和别人亲近对我来说是件容易的事。", "reverse": true },
  { "id": "r2", "type": "scale", "scalePoints": 5, "text": "我不介意依赖别人，也让别人依赖我。", "reverse": true },
  { "id": "r3", "type": "scale", "scalePoints": 5, "text": "我不太担心被人嫌弃或抛弃。", "reverse": true },
  { "id": "r4", "type": "scale", "scalePoints": 5, "text": "我能够自在地接受别人的关心与帮助。", "reverse": true },
  { "id": "r5", "type": "scale", "scalePoints": 5, "text": "我发现别人通常愿意和我亲近。", "reverse": true },
  { "id": "r6", "type": "scale", "scalePoints": 5, "text": "我相信自己是值得被爱的人。", "reverse": true },
  { "id": "r7", "type": "scale", "scalePoints": 5, "text": "当我和别人变得亲密时，我感到舒服和安心。", "reverse": true },
  { "id": "r8", "type": "scale", "scalePoints": 5, "text": "我遇到困难时，通常会向信任的人求助。", "reverse": true },
  { "id": "r9", "type": "scale", "scalePoints": 5, "text": "我相信大多数人本质上是善意的、可以靠近的。", "reverse": true },
  { "id": "r10", "type": "scale", "scalePoints": 5, "text": "在亲密关系中，我能够坦然表达自己的需要。", "reverse": true },
  { "id": "r11", "type": "scale", "scalePoints": 5, "text": "我不太习惯向别人敞开心扉。" },
  { "id": "r12", "type": "scale", "scalePoints": 5, "text": "别人想跟我过分亲近时，我会感到不自在。" },
  { "id": "r13", "type": "scale", "scalePoints": 5, "text": "我更喜欢依靠自己解决问题，而不是求助他人。" },
  { "id": "r14", "type": "scale", "scalePoints": 5, "text": "没有亲密的关系，我也能过得挺好。" },
  { "id": "r15", "type": "scale", "scalePoints": 5, "text": "别人向我倾诉感情时，我会觉得有点别扭。" },
  { "id": "r16", "type": "scale", "scalePoints": 5, "text": "我很难完全信任别人。" },
  { "id": "r17", "type": "scale", "scalePoints": 5, "text": "当关系变得认真起来，我会下意识想抽身。" },
  { "id": "r18", "type": "scale", "scalePoints": 5, "text": "我常常用忙碌来回避深入的感情交流。" },
  { "id": "r19", "type": "scale", "scalePoints": 5, "text": "我不习惯让别人看到自己脆弱的一面。" },
  { "id": "r20", "type": "scale", "scalePoints": 5, "text": "和人保持一点距离，让我更有安全感。" },
  { "id": "r21", "type": "scale", "scalePoints": 5, "text": "我常常担心对方并不像我在乎他/她那样在乎我。" },
  { "id": "r22", "type": "scale", "scalePoints": 5, "text": "我需要反复确认别人是爱我的、重视我的。" },
  { "id": "r23", "type": "scale", "scalePoints": 5, "text": "别人没有及时回复我，我会胡思乱想。" },
  { "id": "r24", "type": "scale", "scalePoints": 5, "text": "我害怕被拒绝，以至于有时干脆不表达。" },
  { "id": "r25", "type": "scale", "scalePoints": 5, "text": "我对关系中的风吹草动格外敏感。" },
  { "id": "r26", "type": "scale", "scalePoints": 5, "text": "我常常觉得自己的感情付出得比对方多。" },
  { "id": "r27", "type": "scale", "scalePoints": 5, "text": "担心被抛弃的念头时常困扰着我。" },
  { "id": "r28", "type": "scale", "scalePoints": 5, "text": "我会为了维持关系而委屈自己、讨好别人。" },
  { "id": "r29", "type": "scale", "scalePoints": 5, "text": "独处时，我常常感到强烈的不安与空虚。" },
  { "id": "r30", "type": "scale", "scalePoints": 5, "text": "我很难相信别人离开我之后还会回来。" }
]
