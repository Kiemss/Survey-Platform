[
  { "id": "q1", "type": "scale", "text": "总的来说，我不愿意让伴侣看到自己内心深处的情感。", "dimension": "avoid" },
  { "id": "q2", "type": "scale", "text": "我很担心失去伴侣的爱。", "dimension": "anxiety" },
  { "id": "q3", "type": "scale", "text": "我愿意向伴侣吐露一些我不会告诉其他任何人的心事。", "dimension": "avoid", "reverse": true },
  { "id": "q4", "type": "scale", "text": "我经常担心伴侣并不是真的爱我。", "dimension": "anxiety" },
  { "id": "q5", "type": "scale", "text": "当伴侣想和我非常亲近时，我会感到不自在。", "dimension": "avoid" },
  { "id": "q6", "type": "scale", "text": "我经常担心伴侣会不想和我继续在一起。", "dimension": "anxiety" },
  { "id": "q7", "type": "scale", "text": "我不习惯向伴侣敞开心扉。", "dimension": "avoid" },
  { "id": "q8", "type": "scale", "text": "我担心自己爱伴侣的程度，超过了伴侣爱我的程度。", "dimension": "anxiety" },
  { "id": "q9", "type": "scale", "text": "对我来说，和伴侣变得亲近是一件很容易的事。", "dimension": "avoid", "reverse": true },
  { "id": "q10", "type": "scale", "text": "我经常为我们的恋爱关系感到忧虑。", "dimension": "anxiety" },
  { "id": "q11", "type": "scale", "text": "我很难允许自己去依赖伴侣。", "dimension": "avoid" },
  { "id": "q12", "type": "scale", "text": "我不担心自己会被抛弃。", "dimension": "anxiety", "reverse": true },
  { "id": "q13", "type": "scale", "text": "当伴侣与我过于亲近时，我会感到紧张。", "dimension": "avoid" },
  { "id": "q14", "type": "scale", "text": "当我向伴侣表露情感时，我会担心他/她不会以同样的方式回应我。", "dimension": "anxiety" },
  { "id": "q15", "type": "scale", "text": "我能够自在地依赖伴侣。", "dimension": "avoid", "reverse": true },
  { "id": "q16", "type": "scale", "text": "看不到伴侣的时候，我会担心他/她会对别人产生兴趣。", "dimension": "anxiety" },
  { "id": "q17", "type": "scale", "text": "我通常会把自己遇到的问题和烦恼告诉伴侣。", "dimension": "avoid", "reverse": true },
  { "id": "q18", "type": "scale", "text": "我需要伴侣经常向我保证他/她是爱我的。", "dimension": "anxiety" },
  { "id": "q19", "type": "scale", "text": "我不喜欢事事都告诉伴侣。", "dimension": "avoid" },
  { "id": "q20", "type": "scale", "text": "我害怕伴侣一旦真正了解我，就不会再喜欢我了。", "dimension": "anxiety" },
  { "id": "q21", "type": "scale", "text": "我能够自在地让伴侣依赖我。", "dimension": "avoid", "reverse": true },
  { "id": "q22", "type": "scale", "text": "我很少担心我们的关系会走到尽头。", "dimension": "anxiety", "reverse": true },
  { "id": "q23", "type": "scale", "text": "能自己解决的事情，我不想麻烦伴侣。", "dimension": "avoid" },
  { "id": "q24", "type": "scale", "text": "即使伴侣暂时对我有些冷淡，我也不会胡思乱想。", "dimension": "anxiety", "reverse": true },
  { "id": "q25", "type": "scale", "text": "我不习惯向伴侣寻求安慰和支持。", "dimension": "avoid" },
  { "id": "q26", "type": "scale", "text": "伴侣和别的异性来往较多，我也不会太担心。", "dimension": "anxiety", "reverse": true },
  { "id": "q27", "type": "scale", "text": "我愿意和伴侣分享内心深处的想法和感受。", "dimension": "avoid", "reverse": true },
  { "id": "q28", "type": "scale", "text": "我对伴侣对我的感情很有把握，很少患得患失。", "dimension": "anxiety", "reverse": true },
  { "id": "q29", "type": "scale", "text": "我几乎会把所有的事情都告诉伴侣。", "dimension": "avoid", "reverse": true },
  { "id": "q30", "type": "scale", "text": "当伴侣没有及时回复我的消息时，我不会往坏处想。", "dimension": "anxiety", "reverse": true },
  { "id": "q31", "type": "scale", "text": "相比和伴侣时刻黏在一起，我更喜欢保有自己的独立空间。", "dimension": "avoid" },
  { "id": "q32", "type": "scale", "text": "我不担心自己在这段感情中付出得比对方多。", "dimension": "anxiety", "reverse": true },
  { "id": "q33", "type": "scale", "text": "遇到麻烦的时候，向伴侣求助能让我感到安心。", "dimension": "avoid", "reverse": true },
  { "id": "q34", "type": "scale", "text": "我很少需要伴侣反复向我保证他/她爱我。", "dimension": "anxiety", "reverse": true },
  { "id": "q35", "type": "scale", "text": "需要伴侣的陪伴和安慰时，我会主动向他/她开口。", "dimension": "avoid", "reverse": true },
  { "id": "q36", "type": "scale", "text": "就算和伴侣发生争执，我也不会怀疑他/她还会爱我。", "dimension": "anxiety", "reverse": true }
]
