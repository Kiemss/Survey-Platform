[
  { "id": "l1", "type": "scale", "scalePoints": 5, "text": "我和恋人在初次见面时就相互吸引。" },
  { "id": "l2", "type": "scale", "scalePoints": 5, "text": "我和恋人之间有着强烈的身体上的吸引力。" },
  { "id": "l3", "type": "scale", "scalePoints": 5, "text": "我们之间的亲密行为热烈而令人满意。" },
  { "id": "l4", "type": "scale", "scalePoints": 5, "text": "我相信我和恋人是天生的一对。" },
  { "id": "l5", "type": "scale", "scalePoints": 5, "text": "我对人的好感往往来得很快，爱起来热烈投入。" },
  { "id": "l6", "type": "scale", "scalePoints": 5, "text": "看到心爱的人，我很少感到心跳加速或兴奋。", "reverse": true },
  { "id": "l7", "type": "scale", "scalePoints": 5, "text": "恋爱很少让我感到激情澎湃、难舍难分。", "reverse": true },
  { "id": "l8", "type": "scale", "scalePoints": 5, "text": "恋爱就像一场游戏，我享受其中的乐趣，不想太认真。" },
  { "id": "l9", "type": "scale", "scalePoints": 5, "text": "我喜欢在恋人面前保持一点神秘感，不轻易袒露内心。" },
  { "id": "l10", "type": "scale", "scalePoints": 5, "text": "我可以同时与不止一个人交往，而不觉得有什么问题。" },
  { "id": "l11", "type": "scale", "scalePoints": 5, "text": "「逢场作戏」的恋情在我看来是可以接受的。" },
  { "id": "l12", "type": "scale", "scalePoints": 5, "text": "一旦恋爱，我就会认真投入，不再逢场作戏。", "reverse": true },
  { "id": "l13", "type": "scale", "scalePoints": 5, "text": "同时和几个人暧昧会让我良心不安，我从不这样做。", "reverse": true },
  { "id": "l14", "type": "scale", "scalePoints": 5, "text": "爱情既然有输赢，恋爱时留几手也无可厚非。" },
  { "id": "l15", "type": "scale", "scalePoints": 5, "text": "我需要相处和了解较长时间后，才可能真正爱上一个人。" },
  { "id": "l16", "type": "scale", "scalePoints": 5, "text": "理想的爱情是从深厚的友谊慢慢发展而来。" },
  { "id": "l17", "type": "scale", "scalePoints": 5, "text": "爱情最重要的基础是像好朋友一样相处融洽。" },
  { "id": "l18", "type": "scale", "scalePoints": 5, "text": "我更愿意先做朋友，再慢慢发展为恋人。" },
  { "id": "l19", "type": "scale", "scalePoints": 5, "text": "平淡稳定的感情在我看来缺少吸引力。", "reverse": true },
  { "id": "l20", "type": "scale", "scalePoints": 5, "text": "细水长流的爱情太慢了，我更想要轰轰烈烈。", "reverse": true },
  { "id": "l21", "type": "scale", "scalePoints": 5, "text": "在我看来，好的爱情经得起时间的沉淀。" },
  { "id": "l22", "type": "scale", "scalePoints": 5, "text": "选择恋人时，我会考虑对方的学历、家庭背景等现实条件。" },
  { "id": "l23", "type": "scale", "scalePoints": 5, "text": "我会理性评估对方是否适合做长期伴侣。" },
  { "id": "l24", "type": "scale", "scalePoints": 5, "text": "「门当户对」是我考虑感情的重要因素。" },
  { "id": "l25", "type": "scale", "scalePoints": 5, "text": "我相信「合适」比「心动」更重要。" },
  { "id": "l26", "type": "scale", "scalePoints": 5, "text": "只要感觉对了，现实条件不该也不能阻碍爱情。", "reverse": true },
  { "id": "l27", "type": "scale", "scalePoints": 5, "text": "我很少用客观条件去衡量一段感情值不值得开始。", "reverse": true },
  { "id": "l28", "type": "scale", "scalePoints": 5, "text": "对方的经济能力与上进心，是我评估感情的重要方面。" },
  { "id": "l29", "type": "scale", "scalePoints": 5, "text": "恋爱时我容易变得情绪化，大喜大悲。" },
  { "id": "l30", "type": "scale", "scalePoints": 5, "text": "恋人没有及时回复消息时，我会胡思乱想、坐立不安。" },
  { "id": "l31", "type": "scale", "scalePoints": 5, "text": "恋爱中我常缺乏安全感，需要反复确认对方爱我。" },
  { "id": "l32", "type": "scale", "scalePoints": 5, "text": "对方稍微冷淡一点，我就担心我们的关系出了问题。" },
  { "id": "l33", "type": "scale", "scalePoints": 5, "text": "我希望恋人的注意力完全集中在我身上。" },
  { "id": "l34", "type": "scale", "scalePoints": 5, "text": "恋爱中的我通常心态平稳，很少患得患失。", "reverse": true },
  { "id": "l35", "type": "scale", "scalePoints": 5, "text": "就算恋人一时联系不上，我也不会太在意。", "reverse": true },
  { "id": "l36", "type": "scale", "scalePoints": 5, "text": "我愿意为恋人的幸福牺牲自己的利益。" },
  { "id": "l37", "type": "scale", "scalePoints": 5, "text": "爱一个人就是给予，不计较回报。" },
  { "id": "l38", "type": "scale", "scalePoints": 5, "text": "只要对方过得好，我可以让自己受点委屈。" },
  { "id": "l39", "type": "scale", "scalePoints": 5, "text": "我认为爱的最高境界是无私的奉献。" },
  { "id": "l40", "type": "scale", "scalePoints": 5, "text": "我会主动为恋人做事，哪怕给自己带来麻烦。" },
  { "id": "l41", "type": "scale", "scalePoints": 5, "text": "恋爱中我会先照顾好自己的需要，再去考虑对方。", "reverse": true },
  { "id": "l42", "type": "scale", "scalePoints": 5, "text": "付出就该有回报，这是我在感情中的原则。", "reverse": true }
]
