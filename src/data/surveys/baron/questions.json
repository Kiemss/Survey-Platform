[
  { "id": "b1", "type": "scale", "scalePoints": 5, "text": "我能清楚地觉察自己当下的情绪和感受。" },
  { "id": "b2", "type": "scale", "scalePoints": 5, "text": "我能说出自己为什么难过或开心。" },
  { "id": "b3", "type": "scale", "scalePoints": 5, "text": "我了解自己的优点和缺点。" },
  { "id": "b4", "type": "scale", "scalePoints": 5, "text": "我很难控制自己的脾气。", "reverse": true },
  { "id": "b5", "type": "scale", "scalePoints": 5, "text": "我能坦然地表达自己的想法和感受。" },
  { "id": "b6", "type": "scale", "scalePoints": 5, "text": "我懂得维护自己的合理权益，敢于说「不」。" },
  { "id": "b7", "type": "scale", "scalePoints": 5, "text": "我常常觉得自己一无是处。", "reverse": true },
  { "id": "b8", "type": "scale", "scalePoints": 5, "text": "我很独立，遇到问题习惯先自己想办法。" },
  { "id": "b9", "type": "scale", "scalePoints": 5, "text": "我能体察别人的情绪和处境。" },
  { "id": "b10", "type": "scale", "scalePoints": 5, "text": "朋友心情不好时，我通常能很快察觉到。" },
  { "id": "b11", "type": "scale", "scalePoints": 5, "text": "我很难建立并维持令人满意的人际关系。", "reverse": true },
  { "id": "b12", "type": "scale", "scalePoints": 5, "text": "我是一个值得信赖、乐于合作的人。" },
  { "id": "b13", "type": "scale", "scalePoints": 5, "text": "我愿意参加集体活动或社会公益。" },
  { "id": "b14", "type": "scale", "scalePoints": 5, "text": "我遇到问题习惯先弄清事实，再做判断。" },
  { "id": "b15", "type": "scale", "scalePoints": 5, "text": "我很难承认自己的错误。", "reverse": true },
  { "id": "b16", "type": "scale", "scalePoints": 5, "text": "出现突发状况时，我能保持冷静并想出应对办法。" },
  { "id": "b17", "type": "scale", "scalePoints": 5, "text": "我能根据情况的变化，灵活调整自己的计划。" },
  { "id": "b18", "type": "scale", "scalePoints": 5, "text": "我做事喜欢按老一套，不太愿意尝试新方法。", "reverse": true },
  { "id": "b19", "type": "scale", "scalePoints": 5, "text": "我能客观地检验自己的想法是否符合现实。" },
  { "id": "b20", "type": "scale", "scalePoints": 5, "text": "我容易一时冲动，事后又后悔。", "reverse": true },
  { "id": "b21", "type": "scale", "scalePoints": 5, "text": "我能抵制眼前的诱惑，先去做更重要的事。" },
  { "id": "b22", "type": "scale", "scalePoints": 5, "text": "面对压力时，我常常慌乱得不知所措。", "reverse": true },
  { "id": "b23", "type": "scale", "scalePoints": 5, "text": "我能较好地承受压力与挫折。" },
  { "id": "b24", "type": "scale", "scalePoints": 5, "text": "我遇到不顺心的事，往往很长时间缓不过来。", "reverse": true },
  { "id": "b25", "type": "scale", "scalePoints": 5, "text": "我对未来总体持乐观态度。" },
  { "id": "b26", "type": "scale", "scalePoints": 5, "text": "我很难让自己开心起来。", "reverse": true },
  { "id": "b27", "type": "scale", "scalePoints": 5, "text": "我觉得生活是有趣的、值得期待的。" },
  { "id": "b28", "type": "scale", "scalePoints": 5, "text": "我常常忧心忡忡，担心这担心那。", "reverse": true },
  { "id": "b29", "type": "scale", "scalePoints": 5, "text": "我会通过设想好的结果来激励自己。" },
  { "id": "b30", "type": "scale", "scalePoints": 5, "text": "我能察觉自己说话时的语气和肢体语言传达了什么。" },
  { "id": "b31", "type": "scale", "scalePoints": 5, "text": "别人向我倾诉时，我会认真倾听而不急于评判。" },
  { "id": "b32", "type": "scale", "scalePoints": 5, "text": "我经常为自己的情绪失控付出代价。", "reverse": true },
  { "id": "b33", "type": "scale", "scalePoints": 5, "text": "总的来说，我对自己感到满意。" }
]
